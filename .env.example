# Supabase connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Session pooler" URI for a long-running server, or the "Transaction
# pooler" URI on a serverless host such as Vercel.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Set once and keep it. Changing it signs every user out.
SESSION_SECRET=

# 1 when a TLS terminator is in front of the app (Vercel, Supabase, any HTTPS
# host). Also makes the kiosk fail closed until a passphrase is configured.
SECURE_COOKIES=1

PORT=3000
HOST=0.0.0.0

# Used only by the very first `npm run seed`.
# ADMIN_EMAIL=admin@mindwave.pk
# ADMIN_PASSWORD=
