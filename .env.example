# All optional - the app runs with no configuration at all.
PORT=3000
DB_PATH=data/attendance.db

# Set once a TLS terminator sits in front of the app.
SECURE_COOKIES=0

# Generated and stored in the database if left unset.
# SESSION_SECRET=

# Used only by the very first `npm run seed`.
# ADMIN_EMAIL=admin@mindwave.local
# ADMIN_PASSWORD=
