<%- include('../partials/head') %>

<div class="page-head">
  <h1>Departments and holidays</h1>
</div>

<div class="card">
  <div class="card-head">
    <span class="chip-icon <%= selfEntry.enabled ? 'warn' : 'info' %>"><%- icon('edit', 15) %></span>
    <h2>Employee manual entry</h2>
    <span class="spacer"></span>
    <span class="pill <%= selfEntry.enabled ? 'late' : 'weekly_off' %>">
      <%= selfEntry.enabled ? 'OPEN' : 'closed' %>
    </span>
  </div>
  <div class="card-body">
    <p class="sub" style="margin:0 0 14px">
      While this is open, staff can record their own start and end times for
      past nights from <strong>Fill in my timings</strong> on their own page.
      It exists so history can be completed by the people who know it.
      <strong>Close it once the backfill is done</strong> &mdash; an attendance
      record employees can keep rewriting is no longer evidence. Entries are
      marked as self-reported and appear in the audit trail under their name.
    </p>
    <% if (isAdmin) { %>
      <form method="post" action="/admin/self-entry">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field-row">
          <div class="field">
            <label for="sefrom">Allow nights from</label>
            <input id="sefrom" type="date" name="from"
                   value="<%= selfEntry.from || '' %>">
            <p class="hint">Nothing before this date can be filled in.</p>
          </div>
          <div class="field">
            <label>Status</label>
            <label style="font-weight:500; color:var(--text)">
              <input type="checkbox" name="enabled" value="1"
                     <%= selfEntry.enabled ? 'checked' : '' %>>
              Open for manual entry
            </label>
          </div>
        </div>
        <button class="btn <%= selfEntry.enabled ? '' : 'primary' %>" type="submit">
          <%= selfEntry.enabled ? 'Update / close' : 'Open manual entry' %>
        </button>
      </form>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <span class="chip-icon <%= kioskLocked ? 'ok' : 'bad' %>"><%- icon('shield', 15) %></span>
    <h2>Kiosk device lock</h2>
    <span class="spacer"></span>
    <span class="pill <%= kioskLocked ? 'present' : 'absent' %>">
      <%= kioskLocked ? 'locked' : 'OPEN TO ANYONE' %>
    </span>
  </div>
  <div class="card-body">
    <p class="sub" style="margin:0 0 14px">
      The kiosk screen takes a code and a PIN from anyone who opens it &mdash;
      which is the point on a shared tablet by the door, and a problem the
      moment the app is reachable from the internet. Set a passphrase and each
      device is unlocked once, then remembers for six months. Staff still just
      tap their code and PIN. Changing the passphrase re-locks every device.
      <% if (!kioskLocked) { %>
        <br><strong class="bad-text">No passphrase is set. Do not expose this
        app publicly until you set one, or disable the kiosk.</strong>
      <% } %>
    </p>
    <% if (isAdmin) { %>
      <form method="post" action="/admin/kiosk-lock">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field" style="max-width:320px">
          <label for="kioskpass">Passphrase</label>
          <input id="kioskpass" type="text" name="passphrase" autocomplete="off"
                 placeholder="<%= kioskLocked ? 'enter a new one to replace it' : 'at least 6 characters' %>">
          <p class="hint">Leave blank and save to remove the lock entirely.</p>
        </div>
        <button class="btn <%= kioskLocked ? '' : 'primary' %>" type="submit">
          <%= kioskLocked ? 'Replace / remove passphrase' : 'Lock the kiosk' %>
        </button>
      </form>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <span class="chip-icon info"><%- icon('clock', 15) %></span>
    <h2>Server clock</h2>
    <span class="spacer"></span>
    <span class="pill"><%= clock.zone %></span>
  </div>
  <div class="card-body">
    <p class="sub" style="margin:0">
      Shift times, lateness and the business date a night shift belongs to are
      all read off this clock, so it has to match the clock on the wall here.
      It currently reads <strong><%= clock.now %></strong>
      (UTC<%= clock.offset < 0 ? '-' : '+' %><%= fmt.minutesToTime(Math.abs(clock.offset)) %>).
      If that is not the local time, set <code>APP_TZ</code> in the environment
      to your IANA zone &mdash; <code>Asia/Karachi</code> for Pakistan &mdash;
      and restart. A cloud host runs in UTC unless told otherwise, which
      silently shifts every check-in by the offset.
    </p>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <span class="chip-icon info"><%- icon('calendar', 15) %></span>
    <h2>Leave allowance</h2>
    <span class="spacer"></span>
    <span class="pill leave"><%= leaveAllowance.sick + leaveAllowance.casual %> per month</span>
  </div>
  <div class="card-body">
    <p class="sub" style="margin:0 0 14px">
      What each employee gets per calendar month. It does not carry over - a new
      month starts fresh. Leave marked beyond the allowance still records, and is
      reported separately as <strong>beyond allowance</strong> so payroll can
      decide what to do with it rather than have the system guess.
    </p>
    <% if (isAdmin) { %>
      <form method="post" action="/admin/leave-allowance">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field-row" style="max-width:360px">
          <div class="field">
            <label for="sick">Sick days</label>
            <input id="sick" type="number" name="sick" min="0" max="31"
                   value="<%= leaveAllowance.sick %>">
          </div>
          <div class="field">
            <label for="casual">Casual days</label>
            <input id="casual" type="number" name="casual" min="0" max="31"
                   value="<%= leaveAllowance.casual %>">
          </div>
        </div>
        <button class="btn" type="submit">Save allowance</button>
      </form>
    <% } %>
  </div>
</div>

<div class="grid two">

  <!-- Departments ---------------------------------------------------------- -->
  <div class="card">
    <div class="card-head"><h2>Departments</h2></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Name</th><th class="num">Staff</th><th></th></tr></thead>
        <tbody>
          <% departments.forEach(function (d) { %>
            <tr>
              <td><strong><%= d.name %></strong></td>
              <td class="num"><%= d.headcount %></td>
              <td class="num">
                <% if (isAdmin) { %>
                  <form method="post" action="/admin/departments/<%= d.id %>/delete"
                        onsubmit="return confirm('Remove <%= d.name %>? Its <%= d.headcount %> employee(s) become unassigned.')">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <button class="btn small danger" type="submit">Remove</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
          <% if (!departments.length) { %>
            <tr><td colspan="3" class="empty">No departments yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (isAdmin) { %>
      <div class="card-body" style="border-top:1px solid var(--border)">
        <form method="post" action="/admin/departments">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field">
            <label for="deptname">Add a department</label>
            <input id="deptname" type="text" name="name" required placeholder="e.g. Engineering">
          </div>
          <button class="btn primary" type="submit">Add department</button>
        </form>
      </div>
    <% } %>
  </div>

  <!-- Holidays ------------------------------------------------------------- -->
  <div class="card">
    <div class="card-head">
      <h2>Holidays <%= year %></h2>
      <div class="monthnav">
        <a class="btn small" href="/admin/settings?year=<%= year - 1 %>">&larr; <%= year - 1 %></a>
        <a class="btn small" href="/admin/settings?year=<%= year + 1 %>"><%= year + 1 %> &rarr;</a>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Date</th><th>Occasion</th><th></th></tr></thead>
        <tbody>
          <% holidays.forEach(function (h) { %>
            <tr>
              <td class="nowrap"><%= fmt.prettyDate(h.work_date) %></td>
              <td><strong><%= h.name %></strong></td>
              <td class="num">
                <% if (isAdmin) { %>
                  <form method="post" action="/admin/holidays/<%= h.work_date %>/delete">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <button class="btn small danger" type="submit">Remove</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
          <% if (!holidays.length) { %>
            <tr><td colspan="3" class="empty">No holidays set for <%= year %>.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (isAdmin) { %>
      <div class="card-body" style="border-top:1px solid var(--border)">
        <form method="post" action="/admin/holidays">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field-row">
            <div class="field">
              <label for="hdate">Date</label>
              <input id="hdate" type="date" name="work_date" required>
            </div>
            <div class="field">
              <label for="hname">Occasion</label>
              <input id="hname" type="text" name="name" required placeholder="e.g. Eid holiday">
            </div>
          </div>
          <button class="btn primary" type="submit">Add holiday</button>
          <p class="hint" style="margin-top:8px">
            A holiday applies to everyone. Work recorded on one counts entirely as overtime.
          </p>
        </form>
      </div>
    <% } %>
  </div>
</div>

<% if (isAdmin) { %>
  <p class="sub"><a href="/admin/audit">View the audit trail</a> of every manual correction.</p>
<% } %>

<%- include('../partials/foot') %>
