<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> &middot; Mindwave Attendance</title>
  <link rel="preload" href="/fonts/urbanist-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/afacad-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/fonts/fonts.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/app.css?v=<%= assetV %>">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23ffd233'/><text x='16' y='23' font-size='18' font-family='system-ui' font-weight='bold' text-anchor='middle' fill='%2317191f'>M</text></svg>">
  <script>
    /* Applied before first paint so an explicit theme choice does not flash. */
    (function () {
      try {
        var t = localStorage.getItem('mw-theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      } catch (e) { /* storage blocked: fall back to the system theme */ }
    }());
  </script>
</head>
<body>
<% if (user) {
     const staff = user.role !== 'employee';
     const isAdmin = user.role === 'admin';
     const nav = typeof navCounts !== 'undefined' && navCounts ? navCounts : {};

     /* One list, three renderings: the text bar on a wide screen, the icon
        rail beside it, and the drawer behind the hamburger on a narrow one.
        Keeping it in one place is what stops the drawer drifting out of sync -
        Setup and Audit used to exist only on the rail, which meant neither was
        reachable at all once the rail was hidden on a phone. `topHidden` keeps
        those two out of the text bar, which has no room for them. */
     const navItems = [
       { href: '/', label: 'My attendance', icon: 'clock', on: path === '/' },
     ];
     if (staff) navItems.push(
       { href: '/admin', label: 'Overview', icon: 'grid', on: path === '/admin' },
       { href: '/admin/register', label: 'Register', railLabel: 'Daily register', icon: 'calendar',
         on: path.startsWith('/admin/register'), count: nav.onPremise, countClass: 'ok' },
       { href: '/reports/monthly', label: 'Reports', icon: 'chart',
         on: path.startsWith('/reports/monthly') },
       { href: '/reports/exceptions', label: 'Exceptions', icon: 'alert',
         on: path.startsWith('/reports/exceptions'), count: nav.exceptions, countClass: 'bad' },
       { href: '/admin/employees', label: 'Employees', icon: 'users',
         on: path.startsWith('/admin/employees') || path.startsWith('/admin/import'),
         count: nav.headcount, countClass: '' },
     );
     if (isAdmin) navItems.push(
       { href: '/admin/shifts', label: 'Shifts', icon: 'moon', on: path.startsWith('/admin/shifts') },
       { href: '/admin/settings', label: 'Setup', icon: 'settings',
         on: path.startsWith('/admin/settings'), topHidden: true },
       { href: '/admin/audit', label: 'Audit trail', icon: 'shield',
         on: path.startsWith('/admin/audit'), topHidden: true },
     );
%>
<header class="topbar" id="topbar">
  <div class="topbar-inner">
    <button class="icon-btn nav-toggle" id="nav-toggle" type="button"
            aria-label="Menu" aria-expanded="false" aria-controls="nav-drawer">
      <%- icon('menu', 18) %>
    </button>

    <a class="brand" href="/">
      <span class="brand-mark">M</span>
      Mindwave
      <span class="brand-sub">Attendance</span>
    </a>

    <nav class="main">
      <% navItems.forEach(function (it) { if (it.topHidden) return; %>
        <a href="<%= it.href %>" class="<%= it.on ? 'on' : '' %>">
          <%= it.label %>
          <% if (it.count) { %><span class="count <%= it.countClass %>"><%= it.count %></span><% } %>
        </a>
      <% }); %>
    </nav>

    <div class="top-right">
      <span class="top-user"><b><%= user.name %></b></span>
      <button class="icon-btn" id="theme-toggle" type="button" title="Theme">
        <span data-mode="auto"><%- icon('contrast', 16) %></span>
        <span data-mode="light" hidden><%- icon('sun', 16) %></span>
        <span data-mode="dark" hidden><%- icon('moon', 16) %></span>
      </button>
      <a class="icon-btn top-wide" href="/password" title="Change password"><%- icon('settings', 16) %></a>
      <form method="post" action="/logout" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="icon-btn" type="submit" title="Sign out"><%- icon('logout', 16) %></button>
      </form>
      <% if (isAdmin) { %>
        <a class="icon-btn accent top-wide" href="/admin/employees/new" title="Add employee"><%- icon('plus', 16) %></a>
      <% } %>
    </div>
  </div>

  <div class="nav-backdrop" id="nav-backdrop"></div>

  <nav class="nav-drawer" id="nav-drawer" aria-label="Main">
    <div class="nav-drawer-user">
      <%- avatar(user.name, user.emp_code) %>
      <div>
        <div class="nm"><%= user.name %></div>
        <div class="id"><%= user.emp_code %></div>
      </div>
    </div>
    <% navItems.forEach(function (it) { %>
      <a href="<%= it.href %>" class="<%= it.on ? 'on' : '' %>">
        <%- icon(it.icon, 18) %>
        <span><%= it.label %></span>
        <% if (it.count) { %><span class="count <%= it.countClass %>"><%= it.count %></span><% } %>
      </a>
    <% }); %>

    <%# The two icon buttons the bar has no room for at this width. %>
    <div class="nav-drawer-extra">
      <% if (isAdmin) { %>
        <a href="/admin/employees/new"><%- icon('plus', 18) %><span>Add employee</span></a>
      <% } %>
      <a href="/password"><%- icon('user', 18) %><span>Change password</span></a>
    </div>
  </nav>
</header>

<div class="shell">
  <aside class="rail">
    <%- avatar(user.name, user.emp_code) %>
    <% navItems.forEach(function (it) { %>
      <a href="<%= it.href %>" data-label="<%= it.railLabel || it.label %>"
         class="<%= it.on ? 'on' : '' %>"><%- icon(it.icon, 19) %></a>
    <% }); %>
  </aside>

  <div class="content">
<% } else { %>
  <div class="content">
<% } %>

<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash <%= flash.kind %>">
    <%- icon(flash.kind === 'ok' ? 'check' : 'alert', 16) %>
    <span><%= flash.message %></span>
  </div>
<% } %>
