<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> &middot; Mindwave Attendance</title>
  <link rel="preload" href="/fonts/urbanist-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/afacad-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/fonts/fonts.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/app.css?v=<%= assetV %>">
  <script>
    /* Applied before first paint so an explicit theme choice does not flash. */
    (function () {
      try {
        var t = localStorage.getItem('mw-theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      } catch (e) { /* storage blocked: fall back to the system theme */ }
    }());
  </script>
</head>
<body>
<div class="centered">
  <div class="panel">
    <div class="brand-mark">M</div>
    <h1>Mindwave Attendance</h1>
    <p class="sub">Sign in with your work email.</p>

    <% if (error) { %><div class="flash err"><%= error %></div><% } %>

    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">

      <div class="field">
        <label for="email">Work email</label>
        <input id="email" name="email" type="email" value="<%= email %>"
               required autofocus autocomplete="username">
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password"
               required autocomplete="current-password">
      </div>

      <button class="btn primary" type="submit" style="width:100%">Sign in</button>
    </form>

    <p class="sub" style="margin-top:18px; text-align:center">
      No login? Use the <a href="/kiosk">entrance kiosk</a>.
    </p>
  </div>
</div>
<script src="/theme.js?v=<%= assetV %>"></script>
</body>
</html>
